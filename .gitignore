# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example committed for handover
!.env.example

# Payload local upload store — runtime data, not source. Production uses R2.
media/

# TypeScript incremental build cache
*.tsbuildinfo

# Reference catalogue (large binary, kept out of git — shared directly instead)
*.pdf

# Timestamped backups produced by scripts/migrate-media.ts
media-backup-*/
