# Database — Neon Postgres (ap-southeast-1)
DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require

# Payload
PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email (Resend) — leave blank locally; leads still save and are logged to console
RESEND_API_KEY=
LEAD_NOTIFY_TO=grenterprises0409@gmail.com
LEAD_NOTIFY_FROM=GR Enterprises <onboarding@resend.dev>

# Cloudflare Turnstile — blank disables the check in development
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Uploads — which adapter stores media.
#   vercel-blob | r2 | local
# Leave blank to auto-detect: Blob if its token is set, else R2, else local disk.
# NOTE: switching drivers does not move existing files. Anything already
# uploaded stays in the old store and must be re-uploaded.
STORAGE_DRIVER=

# Vercel Blob — created automatically when you add a Blob store to the project
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 — the eventual home; free egress
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
